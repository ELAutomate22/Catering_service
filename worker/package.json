{
  "name": "yeshua-reviews-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run check && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply yeshua-reviews --remote",
    "db:migrate:local": "wrangler d1 migrations apply yeshua-reviews --local",
    "admin:password": "node scripts/set-admin-password.mjs",
    "check": "node --check src/index.js && node scripts/check-admin-app.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
